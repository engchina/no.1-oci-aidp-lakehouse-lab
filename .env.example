# =============================================================
# OCI AI Data Platform Lab Console 環境変数
# 本ファイルは init_script.sh が .env.example から作成し、
# /u01/aipoc/props/ 配下の値で上書きします。手動編集は
# 「環境設定」タブで保存される値以外は推奨しません。
# =============================================================

# Oracle Client Library Directory（この lab 構成では thin mode のため未使用でも可）
ORACLE_CLIENT_LIB_DIR=

# ATP（OLTP）ADMIN 接続文字列: user/password@dsn
ORACLE_26AI_CONNECTION_STRING=TODO
# AI Lakehouse ADMIN 接続文字列: user/password@dsn
ORACLE_LAKEHOUSE_CONNECTION_STRING=TODO
# ウォレット展開先ディレクトリ（init_script.sh が設定）
WALLET_ATP_DIR=/u01/aipoc/wallets/atp
WALLET_LH_DIR=/u01/aipoc/wallets/lh

# Gradio Web 認証（ADMIN）
APP_ADMIN_PASSWORD=TODO
# 未使用（No.1-SQL-Assist 互換の VPD ユーザー機構は本 lab では無効）
ORACLE_VPD_LOGIN_USERS=
APP_VPD_SHARED_PASSWORD=
ORACLE_VPD_RUNTIME_CONNECTION_STRING=

# OCI API（GenAI / リソース操作）—「環境設定」タブで保存される
OCI_COMPARTMENT_OCID=TODO
OCI_COHERE_EMBED_MODEL=cohere.embed-v4.0
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# LLM 設定 —「環境設定」タブで保存される
LLM_SHOW_US_CHICAGO_1_MODELS=true
LLM_SHOW_OPENAI_MODELS=false
LLM_DEFAULT_MODEL=

# ADB 管理タブ用コンテキスト
ADB_NAME=TODO
ADB_OCID=ocid1.autonomousdatabase.oc1..

# Lab 固有設定
AIDP_OCID=TODO
OAC_NAME=TODO
OAC_BASE_URL=
OAC_ACCESS_TOKEN=
OCI_NAMESPACE=
BUCKET_NAME=TODO
SOURCE_SCHEMA_USER=SOURCE_01
SOURCE_SCHEMA_PASSWORD=
GOLD_SCHEMA_USER=GOLD_01
GOLD_SCHEMA_PASSWORD=
# AIDP Notebook コードタブで使えるようにする LLM モデル名（AIDP LLM 設定で登録したもの）
AIDP_LLM_MODEL=xai.grok-4
# AIDP カタログ名（既定は Qiita ハンドオン記事の値）
AIDP_ATP_CATALOG_NAME=atp_external_catalog_01
AIDP_DATA_CATALOG_NAME=airlines_data_catalog_01
AIDP_ADB_CATALOG_NAME=airlines_external_adb_gold_01
EXTERNAL_IP=
